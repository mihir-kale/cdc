# Base URL of the FinePrint backend.
#
# Local development: the FastAPI default, served from backend/ on port 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel (production): set this in the project's Environment Variables, and
# rebuild/deploy after changing it. NEXT_PUBLIC_ values are inlined into the
# client bundle at build time, so they are public by design -- never put a
# secret here. The backend needs no secret or API key.
#
#   NEXT_PUBLIC_API_URL=https://<your-render-service>.onrender.com
#
# The same value must be allowed by the backend, via
# FINEPRINT_ALLOWED_ORIGINS, or the browser will block the request.
#
# If this is unset the app falls back to http://localhost:8000, which is right
# for local work and wrong in production.
