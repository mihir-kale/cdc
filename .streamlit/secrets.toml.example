# Copy to .streamlit/secrets.toml and fill in. That file is git-ignored and must
# never be committed.
#
# On Streamlit Community Cloud, paste the same values into the app's
# "Settings -> Secrets" field instead. Both paths are read by _gemini_config().
#
# The app runs with no key at all: every panel then shows its deterministic
# text, which is the same behaviour as before a provider was wired in.
#
# Either block works on its own. If both are present, Gemini wins.

# --- DeepSeek (OpenAI-compatible) -----------------------------------------
[deepseek]
# From https://platform.deepseek.com/api_keys
api_key = "sk-..."

# Optional.
# model = "deepseek-chat"

# --- Google Gemini -------------------------------------------------------
# [gemini]
# api_key = "..."
# model = "gemini-3.6-flash"
#
# Quota: the Gemini free tier allows 20 requests per day per model per project.
# The household panel generates its analysis on page load, so a deployed app
# spends that in 20 views and then falls back to the deterministic text. That
# fallback is safe and silent. Enable billing if the model is meant to be used.
