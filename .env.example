# FinePrint does not require any secret or API key to run. Neither the
# FastAPI service nor the Next.js app reads anything from this file.
#
# The backend has exactly one setting, and it is not a secret:
#
#   FINEPRINT_ALLOWED_ORIGINS=http://localhost:3000
#
# The frontend is configured in frontend/.env.example instead.
#
# The variables below are for planned work that is not implemented yet
# (Reddit consumer sentiment analysis, LLM features). Listed for reference so
# the file is not a surprise later; nothing currently reads them.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
OPENAI_API_KEY=
