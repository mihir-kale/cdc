# Environment / secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Node (browser-checks/ only; there is no frontend any more)
node_modules/

# Data (datasets are large; fetch them with a script, don't commit them)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/raw/README.md
!data/processed/.gitkeep

# Artifacts written by SNAPModeltrain.py, the teammate's original training
# script. The root snap_xgboost.json is tracked but nothing reads it -- app.py
# used to, and now loads backend/app/generated/financial_impact_model.json via
# financial_impact.py instead. This entry only affects newly built copies. See
# "Known rough edges" in README.md before changing anything here.
snap_xgboost.json
*.ubj

# OS
.DS_Store
