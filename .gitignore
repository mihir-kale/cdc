# Data (datasets are large; fetch them with a script, don't commit them)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/raw/README.md
!data/processed/.gitkeep

# Model artifacts retrained by the Streamlit prototype. The root
# snap_xgboost.json is already tracked, so this only affects newly built copies
# and stops them showing up as untracked noise. The served artifact is
# backend/app/generated/financial_impact_model.json and stays tracked; see
# "Two SNAP models" in README.md before changing anything here.
snap_xgboost.json
*.ubj

# OS
.DS_Store
